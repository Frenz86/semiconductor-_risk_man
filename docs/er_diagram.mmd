erDiagram

    %% ═══════════════════════════════════════════════════════════
    %% SEMICONDUCTOR SUPPLY CHAIN RISK MANAGER — ER Diagram v5.0
    %% ═══════════════════════════════════════════════════════════

    Part_Numbers {
        string  Part_Number           PK  "Manufacturer PN"
        string  Supplier_Name             "Silicon vendor"
        string  Category                  "MPU|MCU|Memory|PMIC|Sensor|Passive|Other"
        string  Frontend_Country          "Wafer fab country (geo risk 60%)"
        string  Backend_Country           "OSAT country (geo risk 40%)"
        string  Country_Plant_1           "Legacy fab country 1"
        string  Country_Plant_2           "Legacy fab country 2"
        string  Country_Plant_3           "Legacy fab country 3"
        string  Country_Plant_4           "Legacy fab country 4"
        int     Lead_Time_Weeks           "Factor 3"
        string  EOL_Status                "Active|NRND|Last_Buy|EOL|Obsolete — Factor 8"
        string  Proprietary               "Y|N — Factor 7"
        int     Number_of_Alt_Sources     "Factor 9"
        string  Allocation_Status         "Normal|Constrained|Allocated — Factor 11"
        string  Supplier_Financial_Health "A|B|C|D — Factor 10"
        float   Last_Price_Increase_Pct   "Factor 12"
        int     Technology_Node_nm        "Factor 15"
        string  Package_Type              "BGA|QFN|WLCSP|FCBGA|3D-IC — Factor 13"
        string  Automotive_Grade          "None|AEC-Q100|AEC-Q101|AEC-Q200"
        int     Weeks_to_Qualify          "Re-qual time — Factor 6"
        float   Unit_Price_USD
        string  Functional_Dependencies   "Comma-sep PNs — Factor 5"
        string  EMS_Used                  "Y|N"
        string  EMS_Name                  "FK hint → EMS_Providers"
        string  Memory_Type               "Legacy interface field"
        string  Supported_Interfaces      "DDR4,DDR5,PCIe… — Factor 19 / Alt Engine"
        string  OS_Type
        string  SW_Code_Size_KB
        string  Wireless_Protocol
        int     MTBF_Hours
        datetime Created_at
        datetime Updated_at
    }

    Clients {
        string  Client_ID        PK
        string  Client_Name
        string  Industry         "Automotive|Industrial|Medical|Defense|Consumer"
        int     Default_Run_Rate "PCB/week"
        string  Contact_Email
        datetime Created_at
    }

    Client_Data {
        string  Part_Number      FK  "→ Part_Numbers"
        string  Client_ID        FK  "→ Clients"
        int     Quantity_In_BOM      "Units per PCB"
        int     Buffer_Stock_Units   "Safety stock — Factor 4"
        int     Custom_Lead_Time_Weeks
        string  Notes
        datetime Last_Updated
    }

    Tier2_Suppliers {
        string  Tier2_Supplier_ID   PK
        string  Tier2_Supplier_Name
        string  Material_Type       "Raw material category"
        string  Material_Key        "Unique material identifier"
        string  Country             "Production country"
        float   Market_Share_Pct    "Global market share %"
        string  Criticality         "CRITICAL|HIGH|MEDIUM|LOW — Factor 14"
        string  Substitutability    "Easy|Hard|Impossible"
        string  Notes
        datetime Created_at
        datetime Updated_at
    }

    Component_Materials {
        string  Part_Number         FK  "→ Part_Numbers"
        string  Material_Key        FK  "→ Tier2_Suppliers"
        string  Tier2_Supplier_ID   FK  "→ Tier2_Suppliers"
        string  Material_Name
        string  Custom_Concentration
        string  Custom_Country      "Override fab country"
        string  Notes
        datetime Created_at
    }

    EMS_Providers {
        string  EMS_ID                  PK
        string  EMS_Name
        string  Country                 "Factor 16"
        string  Financial_Health        "A|B|C|D — Factor 16"
        float   Capacity_Utilization_Pct "0–100 — Factor 16"
        string  Certifications          "ISO9001|IATF16949|AS9100|IPC-J-STD"
        int     Backup_Sites_Count
        int     Years_Business
        string  Notes
        datetime Created_at
        datetime Updated_at
    }

    Distributors {
        string  Distributor_ID          PK
        string  Name
        string  Country                 "Factor 17"
        string  Financial_Health        "A|B|C|D — Factor 17"
        int     Lead_Time_Markup_Weeks  "Extra weeks vs. direct"
        int     Stock_Level_Weeks_Coverage
        string  Certifications          "AS9120|ISO9001"
        int     Backup_Count
        string  Notes
        datetime Created_at
        datetime Updated_at
    }

    Part_Distributors {
        string  Part_Number     FK  "→ Part_Numbers"
        string  Distributor_ID  FK  "→ Distributors"
        string  Priority        "Primary|Secondary"
        float   Allocation_Pct  "% sourced from this distributor"
        datetime Created_at
    }

    Alt_Sources {
        string  Part_Number          FK  "→ Part_Numbers"
        string  Supplier_Name            "Alternative supplier"
        string  Frontend_Country         "Fab country — Factor 18 Hidden SPOF"
        string  Backend_Country          "OSAT country — Factor 18"
        int     Lead_Time_Weeks
        string  Financial_Health         "A|B|C|D"
        string  Qualification_Status     "Qualified|In_Progress|Not_Started"
        float   Allocation_Pct
        string  Interface_Type           "DDR3|DDR4|DDR5|LPDDR4|LPDDR4X|LPDDR5|NOR_Flash|NAND_Flash — Alt Engine"
        string  Package_Compatible       "Y|N|Partial — Alt Engine"
        string  OS_Compatible            "Linux|RTOS|Baremetal|Any"
        string  Drop_In_Replacement      "Y|N|Partial"
        int     Porting_Effort_Hours     "Alt Engine porting score"
        string  Availability_Status      "Available|Tight|Shortage|Critical|EOL — Alt Engine"
        string  Notes
        datetime Created_at
    }

    Supplier_Profiles {
        string  Supplier_ID              PK
        string  Supplier_Name            "Must match Part_Numbers.Supplier_Name"
        string  Primary_Fab              "Main wafer fab name"
        string  Primary_Fab_Country
        string  Wafer_Source             "e.g. Shin-Etsu, Sumco"
        string  Key_Materials_Override   "JSON: material overrides"
        string  Notes
        datetime Created_at
        datetime Updated_at
    }

    Market_Shortage {
        string   Interface_Type  PK  "DDR4|LPDDR4|NOR_Flash|NAND_Flash|SiC… — Factor 19"
        string   Severity            "Available|Tight|Shortage|Critical — Factor 19"
        date     Since_Date          "Shortage start date"
        string   Notes               "e.g. AI/Data-Center demand surge"
        string   Source              "Nexar API|Manual|Bloomberg|IHS Markit"
        datetime Updated_at
    }

    %% ═══════════════════════════════════════════════════════════
    %% RELAZIONI
    %% ═══════════════════════════════════════════════════════════

    %% Core: Part_Numbers è l'hub centrale
    Part_Numbers    ||--o{  Client_Data         : "used by"
    Clients         ||--o{  Client_Data         : "has"

    Part_Numbers    ||--o{  Component_Materials : "requires material"
    Tier2_Suppliers ||--o{  Component_Materials : "supplies material"

    Part_Numbers    ||--o{  Part_Distributors   : "sold via"
    Distributors    ||--o{  Part_Distributors   : "distributes"

    Part_Numbers    ||--o{  Alt_Sources         : "replaced by"

    %% Supplier_Profiles → Part_Numbers (via Supplier_Name = Manufacturer)
    Supplier_Profiles ||--o{  Part_Numbers      : "manufactures"

    %% EMS_Providers → Part_Numbers (soft link via EMS_Name field)
    EMS_Providers   |o--o{  Part_Numbers        : "assembles (EMS_Name)"

    %% Market_Shortage → Part_Numbers (logical join via Supported_Interfaces / Memory_Type)
    Market_Shortage |o--o{  Part_Numbers        : "impacts (interface match)"

    %% Market_Shortage → Alt_Sources (logical join via Interface_Type)
    Market_Shortage |o--o{  Alt_Sources         : "affects availability"
